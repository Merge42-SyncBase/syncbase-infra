SYNCBASE_WEB_IMAGE=ghcr.io/merge42-syncbase/syncbase-web:sha-replace-me
SYNCBASE_API_IMAGE=ghcr.io/merge42-syncbase/syncbase-api:sha-replace-me
SYNCBASE_WORKER_IMAGE=ghcr.io/merge42-syncbase/syncbase-worker:sha-replace-me
SYNCBASE_MIGRATE_IMAGE=ghcr.io/merge42-syncbase/syncbase-migrate:sha-replace-me
SYNCBASE_MCP_IMAGE=ghcr.io/merge42-syncbase/syncbase-mcp:sha-replace-me

# 외부 OpenSQL 접속 정보. Postgres는 이 compose에서 컨테이너로 뜨지 않습니다.
SYNCBASE_DB_HOST=replace-with-opensql-host
SYNCBASE_DB_PORT=5432
SYNCBASE_DB_NAME=syncbase
SYNCBASE_DB_SSLMODE=require

# 아래 4개 role/권한은 `roles`/`permissions` 1회성 컨테이너가 compose up 할 때마다
# 자동으로 만들고 갱신합니다 (멱등이라 매번 실행해도 안전합니다). owner 계정은 role을
# 만들 수 있는 권한이 있는 계정이어야 합니다 (OpenSQL superuser 또는 그에 준하는 계정).
SYNCBASE_POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-password
SYNCBASE_WEB_DB_PASSWORD=replace-with-a-distinct-url-safe-web-password
SYNCBASE_WORKER_DB_PASSWORD=replace-with-a-distinct-url-safe-worker-password
SYNCBASE_MCP_DB_PASSWORD=replace-with-a-distinct-url-safe-mcp-password
SYNCBASE_ADMIN_USERNAME=admin
SYNCBASE_ADMIN_PASSWORD_BCRYPT=replace-with-bcrypt-hash

SYNCBASE_MCP_TOKEN_FILE=./environments/prod/secrets/mcp-token
SYNCBASE_MCP_TOKEN_SHA256=replace-with-64-character-sha256
SYNCBASE_MCP_ALLOWED_HOSTS=your-production-domain.example,mcp
SYNCBASE_MCP_ALLOWED_ORIGINS=https://your-production-domain.example
SYNCBASE_PUBLIC_BASE_URL=https://your-production-domain.example

# Safe default: terminate HTTPS in a host-local reverse proxy.
SYNCBASE_WEB_BIND_ADDRESS=127.0.0.1
SYNCBASE_WEB_PORT=8080
SYNCBASE_MCP_BIND_ADDRESS=127.0.0.1
SYNCBASE_MCP_PORT=8081
SYNCBASE_ORT_LIBRARY_FILE=libonnxruntime.so.1.26.0

# E5 모델 + ONNX Runtime을 자동으로 받아오는 1회성 컨테이너. 값 변경 불필요.
SYNCBASE_MODEL_FETCHER_IMAGE=ghcr.io/merge42-syncbase/syncbase-model-fetcher:latest
