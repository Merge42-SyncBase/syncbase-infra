# 로컬 개발용 Postgres 컨테이너 접속 정보 (docker compose가 함께 띄워줌, 값 변경 불필요)
SYNCBASE_DB_HOST=postgres
SYNCBASE_DB_SSLMODE=disable

# 기본은 GHCR에서 pull합니다 (was/mcp/embedding/frontend 소스 checkout 불필요).
# 자신이 고치고 있는 레포만 소스로 빌드하려면 environments/local/build-was.yml /
# build-mcp.yml / build-frontend.yml 중 필요한 것만 추가로 -f에 얹으세요.
SYNCBASE_API_IMAGE=ghcr.io/merge42-syncbase/syncbase-api:latest
SYNCBASE_WORKER_IMAGE=ghcr.io/merge42-syncbase/syncbase-worker:latest
SYNCBASE_MIGRATE_IMAGE=ghcr.io/merge42-syncbase/syncbase-migrate:latest
SYNCBASE_WEB_IMAGE=ghcr.io/merge42-syncbase/syncbase-web:latest
SYNCBASE_MCP_IMAGE=ghcr.io/merge42-syncbase/syncbase-mcp:latest

# build-was.yml 또는 build-mcp.yml을 쓸 때만 필요합니다 (syncbase-embedding이
# private module이라 소스 빌드 시 인증이 필요함). `gh auth token > ~/.syncbase-github-token`
# 등으로 만든, Contents:read 권한의 GitHub 토큰 파일 경로를 지정하세요. 순수
# pull만 할 거면(기본값) 이 값은 안 씁니다 — required 에러가 나면 build 파일을
# -f에서 뺐는지 확인하세요.
SYNCBASE_GITHUB_TOKEN_FILE=/absolute/path/to/github-token

SYNCBASE_POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-password
SYNCBASE_WEB_DB_PASSWORD=replace-with-a-distinct-url-safe-web-password
SYNCBASE_WORKER_DB_PASSWORD=replace-with-a-distinct-url-safe-worker-password
SYNCBASE_MCP_DB_PASSWORD=replace-with-a-distinct-url-safe-mcp-password
SYNCBASE_ADMIN_USERNAME=admin
# bcrypt 해시에는 $ 문자가 들어있어서, 따옴표 없이 쓰면 Docker Compose가 변수
# 치환으로 착각해서 값이 깨집니다. 반드시 작은따옴표로 감싸세요.
SYNCBASE_ADMIN_PASSWORD_BCRYPT='replace-with-bcrypt-hash'

SYNCBASE_MCP_TOKEN_FILE=/absolute/protected/client-token
SYNCBASE_MCP_TOKEN_SHA256=replace-with-64-character-sha256
SYNCBASE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp
SYNCBASE_MCP_ALLOWED_ORIGINS=
SYNCBASE_PUBLIC_BASE_URL=http://127.0.0.1:8080

SYNCBASE_WEB_BIND_ADDRESS=127.0.0.1
SYNCBASE_WEB_PORT=8080
SYNCBASE_MCP_BIND_ADDRESS=127.0.0.1
SYNCBASE_MCP_PORT=8081
SYNCBASE_ORT_LIBRARY_FILE=libonnxruntime.so.1.26.0

# E5 모델 + ONNX Runtime을 자동으로 받아오는 1회성 컨테이너. 값 변경 불필요.
SYNCBASE_MODEL_FETCHER_IMAGE=ghcr.io/merge42-syncbase/syncbase-model-fetcher:latest
